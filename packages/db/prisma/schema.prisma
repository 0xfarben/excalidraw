// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  password  String
  photo     String?
  // every user can be in multiple rooms
// 1-to-Many Relationship
  rooms     Room[]
  // every user can send multiple chat msg's
// 1-to-Many Relationship
  chat      Chat[]
} 
// user may have multiple rooms

model Room {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  createdAt DateTime @default(now())
  adminId   String
  // one room can have only multiple admin/user
  admin     User     @relation( fields: [adminId], references: [id])
  // one room can have multiple chat messages
  // 1-to-Many Relationship
  chats     Chat[]
}

model Chat {
  id        Int     @id @default(autoincrement())
  message   String
  userId    String
  roomId    Int

  //  every chat is a part of a room. 
  room      Room    @relation(fields: [roomId], references: [id])
  // every chat will be having associated user.
  user      User    @relation(fields: [userId], references: [id])
}